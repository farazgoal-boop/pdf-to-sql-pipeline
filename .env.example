# ---------------------------------------------------------------------------
# PDF -> SQL Extractor settings
# Copy this file to .env and adjust. Every setting is optional.
# ---------------------------------------------------------------------------

# Database connection (SQLAlchemy URL).
# Default: a local SQLite file at output/pdf_data.db (no server needed).
# DATABASE_URL=sqlite:///output/pdf_data.db
#
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://pdf_user:your_password@localhost:5432/pdf_data
#
# MySQL / MariaDB (keep charset=utf8mb4 so every character is stored correctly):
# DATABASE_URL=mysql+pymysql://pdf_user:your_password@localhost:3306/pdf_data?charset=utf8mb4
#
# Special characters in the password (@ : / # %) must be URL-encoded, e.g. @ -> %40

# Full path to tesseract.exe.
# Default: C:\Program Files\Tesseract-OCR\tesseract.exe if it exists, otherwise "tesseract" on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR language(s). Combine with +, e.g. eng+deu. The language data must be installed with Tesseract.
OCR_LANG=eng

# A page whose text layer has fewer characters than this is treated as scanned and sent to OCR.
OCR_MIN_CHARS=25

# Resolution used to render pages for OCR. 300 is a good balance; use 400 for very small print.
OCR_DPI=300
